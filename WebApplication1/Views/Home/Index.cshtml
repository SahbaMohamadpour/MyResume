<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cute App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .hero-section {
            background-color: #f8f9fa;
            padding: 4rem 0;
            border-radius: 0 0 20px 20px;
        }

        .feature-icon {
            width: 60px;
            height: 60px;
            background-color: #ffc8dd;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

        .btn-custom {
            background-color: #a2d2ff;
            border-color: #a2d2ff;
            color: #333;
        }

            .btn-custom:hover {
                background-color: #8ac4ff;
                border-color: #8ac4ff;
            }
    </style>
</head>
<body>
    <!-- Navigation -->
   

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container text-center">
            <h1 class="display-4 fw-bold mb-3">Welcome to My Resume App</h1>
            <p class="lead mb-4">A delightful experience awaits you with our simple and elegant solution.</p>
            <div class="d-flex justify-content-center gap-3">
               
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-5">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4">
                    <div class="feature-icon">
                        <span class="fs-4">✨</span>
                    </div>
                    <h4>Easy to Use</h4>
                    <p>Simple interface that anyone can master in minutes.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-icon">
                        <span class="fs-4">🚀</span>
                    </div>
                    <h4>Fast Performance</h4>
                    <p>Lightning-fast responses for all your needs.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-icon">
                        <span class="fs-4">🔒</span>
                    </div>
                    <h4>Secure</h4>
                    <p>Your data is protected with industry-standard security.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-light py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0">&copy; 2023 My Cute App. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>