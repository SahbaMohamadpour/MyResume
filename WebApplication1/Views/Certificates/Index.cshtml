@model IEnumerable<App.Domain.Models.Certificate>

@{
    ViewData["Title"] = "Certificates";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 text-primary">🏆 Certificates</h1>
        <a asp-action="Create" asp-controller="Certificates" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-circle"></i> Add Certificate
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-primary">@item.Name</h6>
                        <p class="card-text text-muted small mb-1">
                            <i class="bi bi-building"></i> @item.Organization
                        </p>
                        <p class="card-text text-muted small mb-1">
                            <i class="bi bi-calendar"></i> @item.Date.ToString("MMM yyyy")
                        </p>
                        <div class="mb-2">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="bi @(i < item.Rate ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.CertificateUrl))
                        {
                            <a href="@item.CertificateUrl" target="_blank" class="btn btn-sm btn-outline-info w-100 mb-2">
                                <i class="bi bi-link"></i> View Certificate
                            </a>
                        }
                        <div class="btn-group w-100">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>