@model IEnumerable<App.Domain.Models.Project>

@{
    ViewData["Title"] = "My Projects";
}

<div class="container-fluid px-4 py-5">
    <!-- Header -->
    <div class="row align-items-center mb-5">
        <div class="col">
            <h1 class="display-6 fw-bold text-gradient mb-2">🚀 My Projects</h1>
            <p class="text-muted">A collection of my creative work and technical endeavors</p>
        </div>
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary btn-lg px-4 py-2 glow-effect">
                <i class="bi bi-plus-circle-fill me-2"></i>Add New Project
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-9">
            <div class="empty-state-icon mb-4">
                <i class="bi bi-folder-x display-1"></i>
            </div>
            <h3 class="h4 text-muted mb-3">No projects yet</h3>
            <p class="text-muted mb-4">Start building your portfolio by adding your first project</p>
            <a asp-action="Create" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-plus-circle me-2"></i>Create First Project
            </a>
        </div>
    }
    else
    {
        <!-- Projects Grid -->
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="project-card">
                        <div class="card-header">
                            <div class="project-type-badge">
                                @item.ProjectType
                            </div>
                            <h5 class="project-title">@item.ProjectName</h5>
                        </div>

                        <div class="card-body">
                            <p class="project-description">@item.Description</p>

                            <!-- Technologies -->
                            @if (!string.IsNullOrEmpty(item.TechnologiesUsed))
                            {
                                <div class="technologies-section">
                                    <label class="section-label">Technologies</label>
                                    <div class="tech-tags">
                                        @foreach (var tech in item.TechnologiesUsed.Split(','))
                                        {
                                            <span class="tech-tag">@tech.Trim()</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Links -->
                            <div class="links-section">
                                @if (!string.IsNullOrEmpty(item.ProjectUrl))
                                {
                                    <a href="@item.ProjectUrl" target="_blank" class="project-link">
                                        <i class="bi bi-globe me-1"></i>Live Demo
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(item.GitHubUrl))
                                {
                                    <a href="@item.GitHubUrl" target="_blank" class="project-link">
                                        <i class="bi bi-github me-1"></i>Source Code
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="timestamps">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-plus me-1"></i>@item.CreateAt.ToString("MMM dd, yyyy")
                                </small>
                               @*  @if (item.UpdateAt.HasValue)
                                {
                                    <small class="text-muted">
                                        <i class="bi bi-arrow-clockwise me-1"></i>Updated @item.UpdateAt.Value.ToString("MMM dd, yyyy")
                                    </small>
                                } *@
                            </div>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Custom Styles */
    .text-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .glow-effect:hover {
        box-shadow: 0 0 20px rgba(102, 126, 234, 0.4);
        transition: all 0.3s ease;
    }

    .project-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: none;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .project-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

    .card-header {
        padding: 1.5rem 1.5rem 0;
        border: none;
        background: transparent;
    }

    .project-type-badge {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 1rem;
    }

    .project-title {
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0;
        font-size: 1.25rem;
    }

    .card-body {
        padding: 1rem 1.5rem;
        flex: 1;
    }

    .project-description {
        color: #718096;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .section-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #a0aec0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
        display: block;
    }

    .tech-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .tech-tag {
        background: #edf2f7;
        color: #4a5568;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .links-section {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .project-link {
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }

        .project-link:hover {
            color: #764ba2;
        }

    .card-footer {
        padding: 1rem 1.5rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .timestamps {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid #e2e8f0;
        color: #718096;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-action:hover {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }

    .btn-action-danger:hover {
        background: #e53e3e;
        border-color: #e53e3e;
    }

    .empty-state-icon {
        color: #cbd5e0;
    }

    .py-9 {
        padding-top: 6rem !important;
        padding-bottom: 6rem !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .card-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .actions {
            align-self: flex-end;
        }
    }
</style>