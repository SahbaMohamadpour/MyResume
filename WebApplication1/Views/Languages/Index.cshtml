@model IEnumerable<App.Domain.Models.Language>

@{
    ViewData["Title"] = "Languages";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold text-gradient text-primary">Languages</h1>
                    <p class="text-muted">Manage your language skills and proficiency levels</p>
                </div>
                <a asp-action="Create" class="btn btn-primary btn-lg shadow">
                    <i class="bi bi-plus-circle me-2"></i>Add New Language
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-primary text-white shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-uppercase small fw-bold">Total Languages</div>
                            <div class="h4 mb-0">@Model.Count()</div>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-translate fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    </div>

    <!-- Main Table Card -->
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient bg-primary text-white py-3">
            <h5 class="card-title mb-0 fw-bold">
                <i class="bi bi-list-ul me-2"></i>Language Portfolio
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">
                                <i class="bi bi-translate me-2"></i>
                                @Html.DisplayNameFor(model => model.languageName)
                            </th>
                            <th class="py-3">
                                <i class="bi bi-graph-up me-2"></i>
                                @Html.DisplayNameFor(model => model.LangLevel)
                            </th>
                            <th class="py-3">
                                <i class="bi bi-calendar-plus me-2"></i>
                                @Html.DisplayNameFor(model => model.CreateAt)
                            </th>
                            <th class="py-3">
                                <i class="bi bi-calendar-check me-2"></i>
                                @Html.DisplayNameFor(model => model.UpdateAt)
                            </th>
                            <th class="text-center py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                            <i class="bi bi-translate text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">@Html.DisplayFor(modelItem => item.languageName)</h6>
                                        </div>
                                    </div>
                                </td>
                                
                                <td>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>
                                        @Html.DisplayFor(modelItem => item.CreateAt)
                                    </small>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>
                                        @Html.DisplayFor(modelItem => item.UpdateAt)
                                    </small>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                           data-bs-toggle="tooltip" title="Edit Language">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-pill px-3"
                                           data-bs-toggle="tooltip" title="View Details">
                                            <i class="bi bi-eye me-1"></i>Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                           data-bs-toggle="tooltip" title="Delete Language">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="empty-state">
                <i class="bi bi-translate display-1 text-muted opacity-25"></i>
                <h3 class="mt-3 text-muted">No Languages Added Yet</h3>
                <p class="text-muted mb-4">Start building your language portfolio by adding your first language.</p>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Add Your First Language
                </a>
            </div>
        </div>
    }
</div>

@functions {
    public string GetLevelBadgeClass(string level)
    {
        return level?.ToLower() switch
        {
            "beginner" => "bg-warning text-dark",
            "intermediate" => "bg-info text-white",
            "advanced" => "bg-success text-white",
            "native" => "bg-primary text-white",
            "fluent" => "bg-success text-white",
            _ => "bg-secondary text-white"
        };
    }
}

@section Scripts {
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
}